@model DevTrack.ViewModels.ReportsViewModel
@{ ViewData["Title"] = "Reports"; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">Operational reporting</div><h1>Evidence for the next decision.</h1><p>Use the delivery record to review capacity, quality, and project progress.</p></div><a class="btn btn-outline-secondary" asp-controller="Dashboard" asp-action="Index">Dashboard</a></div>
<div class="chart-grid"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Flow health</div><h2 class="panel-title">Task status distribution</h2></div></div><div class="chart-body"><canvas id="report-tasks"></canvas></div></section><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Quality health</div><h2 class="panel-title">Defect severity distribution</h2></div></div><div class="chart-body"><canvas id="report-bugs"></canvas></div></section></div>
<div class="workspace-grid mt-3"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Portfolio progress</div><h2 class="panel-title">Projects</h2></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Project</th><th>Client</th><th>Status</th><th>Progress</th></tr></thead><tbody>@foreach (var project in Model.Projects) { <tr><td><a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">@project.Name</a></td><td>@project.Client?.CompanyName</td><td><span class="status-chip">@project.Status</span></td><td><div class="d-flex align-items-center gap-2"><div class="progress flex-grow-1"><div class="progress-bar" style="width:@project.Progress%"></div></div><small>@project.Progress%</small></div></td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Audit record</div><h2 class="panel-title">Recent activity</h2></div></div><div class="list-stack">@foreach (var activity in Model.Activities.Take(10)) { <div class="list-row"><span class="list-marker green"></span><div><span class="list-title">@activity.Action</span><span class="list-desc">@activity.Description</span></div><span class="activity-time">@activity.CreatedAtUtc.ToString("dd MMM")</span></div>}</div></section></div>
@section Scripts { <script>const c=['#f05a28','#19222c','#35705e','#725468','#a74032']; const tasks=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.TaskStatusCounts)); const bugs=@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.BugSeverityCounts)); const report=(id,d)=>new Chart(document.getElementById(id),{type:'doughnut',data:{labels:Object.keys(d),datasets:[{data:Object.values(d),backgroundColor:c,borderWidth:0}]},options:{maintainAspectRatio:false,plugins:{legend:{position:'bottom',labels:{boxWidth:9,usePointStyle:true}}}}}); report('report-tasks',tasks); report('report-bugs',bugs);</script> }

