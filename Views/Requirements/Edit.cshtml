@model Requirement
@{ ViewData["Title"] = "Edit requirement"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Requirement record</div><h1>Update @Model.Title.</h1><p>Keep the analysis trace accurate as scope evolves.</p></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
<form method="post" class="form-card"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedAtUtc" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div><div class="col-md-4"><label asp-for="Type" class="form-label"></label><select asp-for="Type" class="form-select" asp-items="Html.GetEnumSelectList<RequirementType>()"></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5"></textarea></div><div class="col-md-6"><label asp-for="ClientId" class="form-label"></label><select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients"></select></div><div class="col-md-6"><label asp-for="ProjectId" class="form-label"></label><select asp-for="ProjectId" class="form-select" asp-items="ViewBag.Projects"><option value="">Unassigned / to be planned</option></select></div><div class="col-md-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div><div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<RequirementStatus>()"></select></div><div class="col-md-3"><label asp-for="BusinessValue" class="form-label"></label><input asp-for="BusinessValue" class="form-control" /></div><div class="col-md-3"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /></div><div class="col-md-6"><label asp-for="AssignedManager" class="form-label"></label><input asp-for="AssignedManager" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-signal">Save changes</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
