@model List<Requirement>
@{ ViewData["Title"] = "Requirements"; }
<div class="page-wrap module-page"><div class="page-heading"><div><span class="eyebrow">Workspace / Discovery</span><h1>Requirements</h1><p class="heading-sub">Turn client needs into clear, testable delivery outcomes.</p></div><div class="heading-actions"><button class="btn btn-ghost"><i class="bi bi-diagram-3"></i> Analysis board</button><button class="btn btn-primary"><i class="bi bi-plus-lg"></i> New requirement</button></div></div><div class="insight-banner"><span class="insight-icon"><i class="bi bi-lightbulb-fill"></i></span><div><strong>Requirement health</strong><span>4 items need analysis before the next planning session.</span></div><a href="#">Review queue <i class="bi bi-arrow-up-right"></i></a></div><div class="panel module-panel"><div class="module-toolbar"><form class="search-form" method="get"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" placeholder="Search requirements, clients or codes..." /><button class="btn btn-ghost">Search</button></form><select class="filter-select"><option>All types</option><option>Functional</option><option>Business</option><option>Technical</option></select><select class="filter-select" onchange="location.href='?status='+this.value"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<RequirementStatus>()){<option value="@status">@status</option>}</select><span class="result-count">@Model.Count requirements</span></div><div class="table-responsive"><table class="table align-middle module-table"><thead><tr><th>Requirement</th><th>Client / project</th><th>Type</th><th>Priority</th><th>Status</th><th>Business value</th><th>Due date</th><th></th></tr></thead><tbody>@foreach(var r in Model){<tr><td><span class="task-code">@r.RequirementCode</span><strong class="table-title">@r.Title</strong><small class="table-muted">@r.Description</small></td><td><strong class="table-title">@r.Client?.CompanyName</strong><small class="table-muted">@r.Project?.Name</small></td><td><span class="type-tag">@r.Type</span></td><td><span class="priority-text priority-@r.Priority.ToString().ToLowerInvariant()"><i class="bi bi-flag-fill"></i> @r.Priority</span></td><td><span class="status-pill @r.Status.ToString().ToLowerInvariant()">@r.Status</span></td><td><div class="value-meter"><span>@r.BusinessValue/10</span><div class="progress"><div class="progress-bar" style="width:@(r.BusinessValue*10)%"></div></div></div></td><td><span class="date-range">@r.DueDate.ToString("MMM d, yyyy")</span></td><td><form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@r.Id" /><select name="status" class="status-select" onchange="this.form.submit()"><option value="@r.Status">Update status</option>@foreach(var next in Enum.GetValues<RequirementStatus>().Where(x=>x!=r.Status)){<option value="@next">@next</option>}</select></form></td></tr>}</tbody></table></div></div></div>
