@model IEnumerable<Requirement>
@{ ViewData["Title"] = "Requirements"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Requirement analysis</div><h1>Decisions before delivery.</h1><p>Capture client intent, assess risk, and turn approved work into implementation.</p></div><a class="btn btn-signal" asp-action="Create">Capture requirement</a></div>
<form class="filter-bar row g-2" method="get"><div class="col-md-5"><input class="form-control" name="search" placeholder="Search requirement or client" /></div><div class="col-md-3"><select class="form-select" name="status" asp-items="Html.GetEnumSelectList<RequirementStatus>()"><option value="">All statuses</option></select></div><div class="col-md-2"><select class="form-select" name="priority" asp-items="Html.GetEnumSelectList<Priority>()"><option value="">All priorities</option></select></div><div class="col-md-2"><button class="btn btn-quiet w-100">Filter</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Requirement</th><th>Client / project</th><th>Type</th><th>Priority</th><th>Status</th><th>Due</th></tr></thead><tbody>@foreach (var requirement in Model) { <tr><td><a asp-action="Details" asp-route-id="@requirement.Id">@requirement.Title</a><div class="record-meta">Value @requirement.BusinessValue / 10</div></td><td>@requirement.Client?.CompanyName<div class="record-meta">@requirement.Project?.Name</div></td><td>@requirement.Type</td><td><span class="priority-chip @(requirement.Priority == Priority.Critical ? "critical" : "")">@requirement.Priority</span></td><td><span class="status-chip">@requirement.Status</span></td><td>@(requirement.DueDate?.ToString("dd MMM yyyy") ?? "—")</td></tr>}</tbody></table></div>@if (!Model.Any()) { <div class="empty-state">No requirements match the selected filters.</div> }</section>
