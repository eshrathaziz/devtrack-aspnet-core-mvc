@model Requirement
@{ ViewData["Title"] = Model.Title; ViewData["Section"] = "Workspace"; var analysis = Model.Analysis ?? new RequirementAnalysis { RequirementId = Model.Id }; }
<div class="page-heading"><div><div class="breadcrumb-text">Requirement analysis</div><h1>@Model.Title</h1><p>@Model.Client?.CompanyName · @Model.Project?.Name</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Index">All requirements</a>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <a class="btn btn-signal" asp-action="Edit" asp-route-id="@Model.Id">Edit requirement</a> }</div></div>
<section class="detail-hero"><div class="detail-meta">@Model.Type · @Model.Priority priority · Status: @Model.Status</div><h1>@Model.Title</h1><p>@Model.Description</p></section>
<div class="detail-grid"><div class="d-grid gap-3"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Linked implementation</div><h2 class="panel-title">Tasks created from this requirement</h2></div><a class="btn btn-sm btn-quiet" asp-controller="Tasks" asp-action="Create">Create task</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Task</th><th>Developer</th><th>Status</th></tr></thead><tbody>@foreach (var task in Model.Tasks) { <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id">@task.Title</a></td><td>@task.Developer?.DisplayName</td><td><span class="status-chip">@task.Status</span></td></tr>}</tbody></table></div></section>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <section class="form-card"><h2>Requirement analysis</h2><form asp-action="SaveAnalysis" method="post"><input type="hidden" asp-for="Id" value="@analysis.Id" /><input type="hidden" name="RequirementId" value="@Model.Id" /><div class="row g-3"><div class="col-md-6"><label class="form-label">Business requirement</label><textarea class="form-control" name="BusinessRequirement" rows="3" required>@analysis.BusinessRequirement</textarea></div><div class="col-md-6"><label class="form-label">Business objective</label><textarea class="form-control" name="BusinessObjective" rows="3" required>@analysis.BusinessObjective</textarea></div><div class="col-md-6"><label class="form-label">Functional requirements</label><textarea class="form-control" name="FunctionalRequirements" rows="4" required>@analysis.FunctionalRequirements</textarea></div><div class="col-md-6"><label class="form-label">Non-functional requirements</label><textarea class="form-control" name="NonFunctionalRequirements" rows="4">@analysis.NonFunctionalRequirements</textarea></div><div class="col-md-6"><label class="form-label">Acceptance criteria</label><textarea class="form-control" name="AcceptanceCriteria" rows="4" required>@analysis.AcceptanceCriteria</textarea></div><div class="col-md-3"><label class="form-label">Dependencies</label><textarea class="form-control" name="Dependencies" rows="4">@analysis.Dependencies</textarea></div><div class="col-md-3"><label class="form-label">Risks</label><textarea class="form-control" name="Risks" rows="4">@analysis.Risks</textarea></div><div class="col-md-3"><label class="form-label">Estimated hours</label><input class="form-control" name="EstimatedHours" type="number" value="@analysis.EstimatedHours" required /></div><div class="col-md-9"><label class="form-label">Technical notes</label><textarea class="form-control" name="TechnicalNotes" rows="2">@analysis.TechnicalNotes</textarea></div></div><button class="btn btn-signal mt-3">Save analysis</button></form>@if (Model.Analysis is not null && Model.Analysis.Decision == AnalysisDecision.Draft) { <div class="d-flex gap-2 mt-3"><form asp-action="ReviewAnalysis" method="post"><input type="hidden" name="requirementId" value="@Model.Id" /><input type="hidden" name="decision" value="Approved" /><button class="btn btn-success">Approve analysis</button></form><form asp-action="ReviewAnalysis" method="post"><input type="hidden" name="requirementId" value="@Model.Id" /><input type="hidden" name="decision" value="Rejected" /><button class="btn btn-outline-danger">Reject analysis</button></form></div> }</section>}</div><aside class="panel p-3"><div class="panel-kicker">Decision context</div><div class="key-value"><small>Business value</small><strong>@Model.BusinessValue / 10</strong></div><div class="key-value"><small>Due date</small><strong>@(Model.DueDate?.ToString("dd MMM yyyy") ?? "Not set")</strong></div><div class="key-value"><small>Accountable manager</small><strong>@(Model.AssignedManager ?? "Unassigned")</strong></div><div class="key-value"><small>Analysis decision</small><strong>@(Model.Analysis?.Decision.ToString() ?? "Not started")</strong></div></aside></div>
