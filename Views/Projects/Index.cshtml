@model IEnumerable<Project>
@{ ViewData["Title"] = "Projects"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Delivery portfolio</div><h1>Projects in motion.</h1><p>Track delivery health, ownership, and linked work.</p></div>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <a class="btn btn-signal" asp-action="Create">Create project</a> }</div>
<form class="filter-bar row g-2" method="get"><div class="col-md-4"><input class="form-control" name="search" placeholder="Search projects or clients" /></div><div class="col-md-3"><select class="form-select" name="status" asp-items="Html.GetEnumSelectList<ProjectStatus>()"><option value="">All statuses</option></select></div><div class="col-md-3"><select class="form-select" name="clientId" asp-items="ViewBag.Clients"><option value="">All clients</option></select></div><div class="col-md-2"><button class="btn btn-quiet w-100">Filter</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Project</th><th>Client</th><th>Manager</th><th>Status</th><th>Priority</th><th>Progress</th></tr></thead><tbody>@foreach (var project in Model) { <tr><td><a asp-action="Details" asp-route-id="@project.Id">@project.Name</a><div class="record-meta">@(project.EndDate?.ToString("dd MMM yyyy") ?? "No target date")</div></td><td>@project.Client?.CompanyName</td><td>@project.ProjectManager</td><td><span class="status-chip">@project.Status</span></td><td><span class="priority-chip @(project.Priority == Priority.Critical ? "critical" : "")">@project.Priority</span></td><td><div class="d-flex align-items-center gap-2"><div class="progress flex-grow-1"><div class="progress-bar" style="width:@project.Progress%"></div></div><small>@project.Progress%</small></div></td></tr>}</tbody></table></div>@if (!Model.Any()) { <div class="empty-state">No projects match the selected filters.</div> }</section>
