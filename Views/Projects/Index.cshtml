@model List<Project>
@{ ViewData["Title"] = "Projects"; }
<div class="page-wrap module-page"><div class="page-heading"><div><span class="eyebrow">Workspace / Delivery</span><h1>Projects</h1><p class="heading-sub">Manage client engagements from discovery through release.</p></div><div class="heading-actions"><button class="btn btn-ghost"><i class="bi bi-filter"></i> Filter</button><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#newProject"><i class="bi bi-plus-lg"></i> New project</button></div></div>
<div class="panel module-panel"><div class="module-toolbar"><form class="search-form" method="get"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" placeholder="Search projects, clients or codes..." /><button class="btn btn-ghost">Search</button></form><select class="filter-select" onchange="location.href='?status='+this.value"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<ProjectStatus>()){<option selected="@(ViewBag.Status?.ToString()==status.ToString())" value="@status">@status</option>}</select><span class="result-count">@Model.Count projects</span></div><div class="table-responsive"><table class="table align-middle module-table"><thead><tr><th>Project</th><th>Client</th><th>Manager</th><th>Status</th><th>Priority</th><th>Progress</th><th>Timeline</th><th></th></tr></thead><tbody>@foreach(var p in Model){<tr><td><a class="entity-link" asp-action="Details" asp-route-id="@p.Id"><span class="entity-avatar purple">@p.Name[0]</span><span><strong>@p.Name</strong><small>@p.ProjectCode</small></span></a></td><td>@p.Client?.CompanyName</td><td>@p.ProjectManager</td><td><span class="status-pill @p.Status.ToString().ToLowerInvariant()">@p.Status</span></td><td><span class="priority-text priority-@p.Priority.ToString().ToLowerInvariant()"><i class="bi bi-flag-fill"></i> @p.Priority</span></td><td><div class="table-progress"><span>@p.Progress%</span><div class="progress"><div class="progress-bar" style="width:@p.Progress%"></div></div></div></td><td><small class="date-range">@p.StartDate.ToString("MMM d") — @p.EndDate.ToString("MMM d, yy")</small></td><td><button class="icon-button"><i class="bi bi-three-dots"></i></button></td></tr>}</tbody></table></div></div></div>
<div class="modal fade" id="newProject" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content quick-modal"><div class="modal-header"><div><span class="eyebrow">Portfolio setup</span><h3>New project</h3></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><form asp-action="Create" method="post"><div class="modal-body"><div class="row g-3"><div class="col-12"><label class="form-label">Project name</label><input class="form-control" name="Name" required placeholder="e.g. Customer portal redesign" /></div><div class="col-md-6"><label class="form-label">Client</label><select class="form-select" name="ClientId" required><option value="">Select client</option>@foreach(Client c in ViewBag.Clients){<option value="@c.Id">@c.CompanyName</option>}</select></div><div class="col-md-6"><label class="form-label">Priority</label><select class="form-select" name="Priority"><option>Medium</option><option>High</option><option>Critical</option><option>Low</option></select></div><div class="col-md-6"><label class="form-label">Start date</label><input class="form-control" type="date" name="StartDate" required /></div><div class="col-md-6"><label class="form-label">Target date</label><input class="form-control" type="date" name="EndDate" required /></div><div class="col-12"><label class="form-label">Description</label><textarea class="form-control" name="Description" rows="3" placeholder="What outcome will this project deliver?"></textarea></div></div></div><div class="modal-footer"><button type="button" class="btn btn-ghost" data-bs-dismiss="modal">Cancel</button><button class="btn btn-primary" type="submit">Create project</button></div></form></div></div></div>
