@model Project
@{ ViewData["Title"] = "Create project"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">New project</div><h1>Plan delivery work.</h1><p>Connect a client, accountable manager, and time horizon.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to projects</a></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-7"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-md-5"><label asp-for="ClientId" class="form-label"></label><select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients"><option value="">Select client</option></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-md-4"><label asp-for="ProjectManager" class="form-label"></label><input asp-for="ProjectManager" class="form-control" /></div><div class="col-md-2"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div><div class="col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProjectStatus>()"></select></div><div class="col-md-2"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" /></div><div class="col-md-2"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control" /></div><div class="col-md-2"><label asp-for="Progress" class="form-label"></label><input asp-for="Progress" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-signal">Create project</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
