@model Project
@{ ViewData["Title"] = "Edit project"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Project record</div><h1>Update @Model.Name.</h1><p>Maintain the delivery plan and current progress.</p></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
<form method="post" class="form-card"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedAtUtc" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-7"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-md-5"><label asp-for="ClientId" class="form-label"></label><select asp-for="ClientId" class="form-select" asp-items="ViewBag.Clients"></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-md-4"><label asp-for="ProjectManager" class="form-label"></label><input asp-for="ProjectManager" class="form-control" /></div><div class="col-md-2"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div><div class="col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ProjectStatus>()"></select></div><div class="col-md-2"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" /></div><div class="col-md-2"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control" /></div><div class="col-md-2"><label asp-for="Progress" class="form-label"></label><input asp-for="Progress" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-signal">Save changes</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
