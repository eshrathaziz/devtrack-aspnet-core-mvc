@model Project
@{ ViewData["Title"] = Model.Name; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Project delivery</div><h1>@Model.Name</h1><p>@Model.Client?.CompanyName · Owned by @Model.ProjectManager</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Index">All projects</a>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <a class="btn btn-signal" asp-action="Edit" asp-route-id="@Model.Id">Edit project</a> }</div></div>
<section class="detail-hero"><div class="detail-meta">@Model.Status · @Model.Priority priority · Target @(Model.EndDate?.ToString("dd MMM yyyy") ?? "not set")</div><h1>@Model.Name</h1><p>@Model.Description</p><div class="mt-3 d-flex align-items-center gap-3"><div class="progress flex-grow-1"><div class="progress-bar" style="width:@Model.Progress%"></div></div><strong>@Model.Progress%</strong></div></section>
<div class="detail-grid"><div class="d-grid gap-3"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Requirement pipeline</div><h2 class="panel-title">Connected requirements</h2></div><a class="btn btn-sm btn-quiet" asp-controller="Requirements" asp-action="Create">Add requirement</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Requirement</th><th>Status</th><th>Priority</th></tr></thead><tbody>@foreach (var item in Model.Requirements) { <tr><td><a asp-controller="Requirements" asp-action="Details" asp-route-id="@item.Id">@item.Title</a></td><td><span class="status-chip">@item.Status</span></td><td><span class="priority-chip">@item.Priority</span></td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Sprint plan</div><h2 class="panel-title">Delivery cadence</h2></div><a class="btn btn-sm btn-quiet" asp-controller="Sprints" asp-action="Create">Add sprint</a></div><div class="list-stack">@foreach (var sprint in Model.Sprints.OrderByDescending(s => s.StartDate)) { <div class="list-row"><span class="list-marker green"></span><div><a class="list-title" asp-controller="Sprints" asp-action="Details" asp-route-id="@sprint.Id">@sprint.Name</a><span class="list-desc">@sprint.Tasks.Count task(s) · @sprint.StartDate.ToString("dd MMM")–@sprint.EndDate.ToString("dd MMM")</span></div><span class="activity-time">@sprint.Status</span></div>}</div></section></div><aside class="d-grid gap-3"><section class="panel p-3"><div class="panel-kicker">Release readiness</div><div class="key-value"><small>Open bugs</small><strong>@Model.Bugs.Count(b => b.Status != BugStatus.Closed)</strong></div><div class="key-value"><small>Releases</small><strong>@Model.Releases.Count</strong></div><div class="key-value"><small>Created</small><strong>@Model.CreatedAtUtc.ToString("dd MMM yyyy")</strong></div></section><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Release plan</div><h2 class="panel-title">Upcoming releases</h2></div></div><div class="list-stack">@foreach (var release in Model.Releases.OrderBy(r => r.ReleaseDate)) { <div class="list-row"><span class="list-marker berry"></span><div><a class="list-title" asp-controller="Releases" asp-action="Details" asp-route-id="@release.Id">@release.Version · @release.Name</a><span class="list-desc">@release.ReleaseDate.ToString("dd MMM yyyy")</span></div></div>}</div></section></aside></div>

