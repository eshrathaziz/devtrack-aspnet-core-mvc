@model Project
@{ ViewData["Title"] = Model.Name; }
<div class="page-wrap module-page"><div class="detail-hero"><div><span class="eyebrow">Projects / @Model.ProjectCode</span><h1>@Model.Name</h1><p>@Model.Description</p><div class="detail-meta"><span class="status-pill @Model.Status.ToString().ToLowerInvariant()">@Model.Status</span><span><i class="bi bi-building"></i> @Model.Client?.CompanyName</span><span><i class="bi bi-person"></i> @Model.ProjectManager</span><span><i class="bi bi-calendar3"></i> @Model.StartDate.ToString("MMM d") — @Model.EndDate.ToString("MMM d, yyyy")</span></div></div><div class="heading-actions"><a class="btn btn-ghost" asp-action="Index"><i class="bi bi-arrow-left"></i> Back to projects</a><button class="btn btn-primary"><i class="bi bi-pencil"></i> Edit project</button></div></div><div class="metrics-grid"><div class="metric-card accent-purple"><span class="metric-label">Delivery progress</span><div class="metric-value">@Model.Progress%</div><div class="progress"><div class="progress-bar" style="width:@Model.Progress%"></div></div></div><div class="metric-card accent-blue"><span class="metric-label">Requirements</span><div class="metric-value">@Model.Requirements.Count</div><div class="metric-foot"><span>Connected outcomes</span></div></div><div class="metric-card accent-teal"><span class="metric-label">Tasks</span><div class="metric-value">@Model.Tasks.Count</div><div class="metric-foot"><span>@Model.Tasks.Count(x=>x.Status==DevTrack.Models.TaskStatus.Done) completed</span></div></div><div class="metric-card accent-amber"><span class="metric-label">Open bugs</span><div class="metric-value">@Model.Bugs.Count(x=>x.Status!=BugStatus.Closed)</div><div class="metric-foot"><span>Quality queue</span></div></div></div><div class="dashboard-grid main-row"><section class="panel"><div class="panel-heading"><div><span class="eyebrow">Execution</span><h2>Connected tasks</h2></div><a class="link-action" asp-controller="Tasks" asp-action="Index">Open task board <i class="bi bi-arrow-up-right"></i></a></div><div class="detail-list">@foreach(var task in Model.Tasks.OrderByDescending(x=>x.UpdatedAt)){<div class="detail-list-row"><div><span class="task-code">@task.TaskCode</span><strong>@task.Title</strong><small>@task.Developer?.Name · @task.Sprint?.Name</small></div><span class="status-pill task-@task.Status.ToString().ToLowerInvariant()">@task.Status</span></div>}</div></section><section class="panel"><div class="panel-heading"><div><span class="eyebrow">Planning</span><h2>Sprints & releases</h2></div></div><div class="detail-list">@foreach(var sprint in Model.Sprints){<div class="detail-list-row"><div><strong>@sprint.Name</strong><small>@sprint.StartDate.ToString("MMM d") — @sprint.EndDate.ToString("MMM d")</small></div><span class="status-pill @sprint.Status.ToString().ToLowerInvariant()">@sprint.Status</span></div>}@foreach(var release in Model.Releases){<div class="detail-list-row"><div><strong>@release.Version · @release.Name</strong><small>Target @release.ReleaseDate.ToString("MMM d, yyyy")</small></div><span class="status-pill @release.Status.ToString().ToLowerInvariant()">@release.Status</span></div>}</div></section></div></div>
