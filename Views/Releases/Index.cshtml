@model List<Release>
@{ ViewData["Title"] = "Releases"; }
<div class="page-wrap module-page"><div class="page-heading"><div><span class="eyebrow">Delivery / Ship room</span><h1>Releases</h1><p class="heading-sub">Coordinate what is shipping, when it is ready, and who needs to know.</p></div><div class="heading-actions"><button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Plan release</button></div></div><div class="release-grid">@foreach(var r in Model){<div class="panel release-card"><div class="release-card-top"><span class="release-version">@r.Version</span><span class="status-pill @r.Status.ToString().ToLowerInvariant()">@r.Status</span></div><h2>@r.Name</h2><p class="release-project"><i class="bi bi-kanban"></i> @r.Project?.Name</p><div class="release-date"><i class="bi bi-calendar3"></i><span>Target release<strong>@r.ReleaseDate.ToString("MMMM d, yyyy")</strong></span></div><p class="release-notes">@r.Notes</p><div class="release-footer"><span><i class="bi bi-check2-circle"></i> Quality gates tracked</span><button class="icon-button"><i class="bi bi-three-dots"></i></button></div></div>}</div></div>
