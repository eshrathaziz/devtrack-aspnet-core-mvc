@model IEnumerable<Release>
@{ ViewData["Title"] = "Releases"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Release management</div><h1>Release with confidence.</h1><p>Connect delivery scope, resolved defects, and deployment readiness.</p></div>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <a class="btn btn-signal" asp-action="Create">Plan release</a> }</div>
<form class="filter-bar row g-2" method="get"><div class="col-md-5"><select class="form-select" name="projectId" asp-items="ViewBag.Projects"><option value="">All projects</option></select></div><div class="col-md-5"><select class="form-select" name="status" asp-items="Html.GetEnumSelectList<ReleaseStatus>()"><option value="">All statuses</option></select></div><div class="col-md-2"><button class="btn btn-quiet w-100">Filter</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Release</th><th>Project</th><th>Date</th><th>Status</th><th>Linked defects</th></tr></thead><tbody>@foreach (var release in Model) { <tr><td><a asp-action="Details" asp-route-id="@release.Id">@release.Version · @release.Name</a><div class="record-meta">@release.Notes</div></td><td>@release.Project?.Name</td><td>@release.ReleaseDate.ToString("dd MMM yyyy")</td><td><span class="status-chip">@release.Status</span></td><td>@release.Bugs.Count</td></tr>}</tbody></table></div></section>
