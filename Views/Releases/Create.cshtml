@model Release
@{ ViewData["Title"] = "Plan release"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">New release</div><h1>Plan a release milestone.</h1><p>Make the version, scope, target date, and deployment notes explicit.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to releases</a></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="ProjectId" class="form-label"></label><select asp-for="ProjectId" class="form-select" asp-items="ViewBag.Projects"><option value="">Select project</option></select></div><div class="col-md-3"><label asp-for="Version" class="form-label"></label><input asp-for="Version" class="form-control" placeholder="e.g. 2.5.0" /></div><div class="col-md-3"><label asp-for="ReleaseDate" class="form-label"></label><input asp-for="ReleaseDate" class="form-control" /></div><div class="col-md-8"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<ReleaseStatus>()"></select></div><div class="col-12"><label asp-for="Notes" class="form-label"></label><textarea asp-for="Notes" class="form-control" rows="5" placeholder="Scope, deployment plan, roll-back notes, or known constraints."></textarea></div></div><button class="btn btn-signal mt-4">Create release</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
