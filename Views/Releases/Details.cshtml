@model Release
@{ ViewData["Title"] = Model.Version; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Release record</div><h1>@Model.Version · @Model.Name</h1><p>@Model.Project?.Name · Target @Model.ReleaseDate.ToString("dd MMM yyyy")</p></div><a class="btn btn-outline-secondary" asp-action="Index">All releases</a></div>
<section class="detail-hero"><div class="detail-meta">@Model.Status · @Model.Bugs.Count linked defect(s)</div><h1>@Model.Version · @Model.Name</h1><p>@Model.Notes</p></section>
<div class="detail-grid"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Release quality</div><h2 class="panel-title">Associated defects</h2></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Defect</th><th>Severity</th><th>Owner</th><th>Status</th></tr></thead><tbody>@foreach (var bug in Model.Bugs) { <tr><td><a asp-controller="Bugs" asp-action="Details" asp-route-id="@bug.Id">@bug.Title</a></td><td><span class="priority-chip @(bug.Severity == BugSeverity.Critical ? "critical" : "")">@bug.Severity</span></td><td>@bug.AssignedDeveloper?.DisplayName</td><td><span class="status-chip">@bug.Status</span></td></tr>}</tbody></table></div></section><aside class="panel p-3"><div class="panel-kicker">Release details</div><div class="key-value"><small>Project</small><strong>@Model.Project?.Name</strong></div><div class="key-value"><small>Status</small><strong>@Model.Status</strong></div><div class="key-value"><small>Release date</small><strong>@Model.ReleaseDate.ToString("dd MMM yyyy")</strong></div></aside></div>
