@model Client
@{ ViewData["Title"] = Model.CompanyName; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">Client account</div><h1>@Model.CompanyName</h1><p>@Model.Industry · @Model.City, @Model.Country</p></div><div class="d-flex gap-2"><a class="btn btn-outline-secondary" asp-action="Index">All clients</a><a class="btn btn-signal" asp-action="Edit" asp-route-id="@Model.Id">Edit record</a></div></div>
<div class="detail-grid"><div class="d-grid gap-3"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Project portfolio</div><h2 class="panel-title">Connected work</h2></div><a class="btn btn-sm btn-quiet" asp-controller="Projects" asp-action="Create">Add project</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Project</th><th>Status</th><th>Progress</th></tr></thead><tbody>@foreach (var project in Model.Projects.OrderByDescending(p => p.CreatedAtUtc)) { <tr><td><a asp-controller="Projects" asp-action="Details" asp-route-id="@project.Id">@project.Name</a></td><td><span class="status-chip">@project.Status</span></td><td>@project.Progress%</td></tr>}</tbody></table></div></section><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Communication history</div><h2 class="panel-title">Client coordination</h2></div></div><div class="list-stack">@foreach (var item in Model.Communications.OrderByDescending(c => c.OccurredAtUtc)) { <div class="list-row"><span class="list-marker"></span><div><span class="list-title">@item.Subject</span><span class="list-desc">@item.Type · @item.Description</span></div><span class="activity-time">@item.OccurredAtUtc.ToString("dd MMM")</span></div>}</div></section></div><aside class="panel p-3"><div class="panel-kicker">Account details</div><div class="key-value"><small>Contact</small><strong>@Model.ContactPerson</strong><span class="record-meta">@Model.Email<br />@Model.Phone</span></div><div class="key-value"><small>Account manager</small><strong>@Model.AccountManager</strong></div><div class="key-value"><small>Status</small><strong>@Model.Status</strong></div><hr /><form asp-action="AddCommunication" method="post"><input type="hidden" name="ClientId" value="@Model.Id" /><h3 class="panel-title mb-3">Log coordination</h3><div class="mb-2"><input class="form-control" name="Subject" placeholder="Subject" required /></div><div class="mb-2"><select class="form-select" name="Type" asp-items="Html.GetEnumSelectList<CommunicationType>()"></select></div><div class="mb-2"><textarea class="form-control" name="Description" rows="3" placeholder="Decision, request, or follow-up" required></textarea></div><button class="btn btn-signal w-100">Record activity</button></form></aside></div>
