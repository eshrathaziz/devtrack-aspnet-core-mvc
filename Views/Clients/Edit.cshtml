@model Client
@{ ViewData["Title"] = "Edit client"; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">Client record</div><h1>Update @Model.CompanyName.</h1><p>Maintain trusted account information for delivery coordination.</p></div><a class="btn btn-outline-secondary" asp-action="Details" asp-route-id="@Model.Id">Cancel</a></div>
<form method="post" class="form-card"><input type="hidden" asp-for="Id" /><input type="hidden" asp-for="CreatedAtUtc" /><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /></div><div class="col-md-6"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" /></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div><div class="col-md-4"><label asp-for="Industry" class="form-label"></label><input asp-for="Industry" class="form-control" /></div><div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div><div class="col-md-4"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div><div class="col-md-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div><div class="col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ClientStatus>()" class="form-select"></select></div><div class="col-md-2"><label asp-for="AccountManager" class="form-label"></label><input asp-for="AccountManager" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-signal">Save changes</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
