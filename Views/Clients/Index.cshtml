@model IEnumerable<Client>
@{ ViewData["Title"] = "Clients"; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">Client portfolio</div><h1>Client relationships.</h1><p>Account context, communications, and connected delivery work.</p></div><a class="btn btn-signal" asp-action="Create">Add client</a></div>
<form class="filter-bar row g-2" method="get"><div class="col-md-5"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search company, contact, or email" /></div><div class="col-md-3"><select class="form-select" name="status" asp-items="Html.GetEnumSelectList<ClientStatus>()"><option value="">All statuses</option></select></div><div class="col-md-2"><select class="form-select" name="sort"><option value="name">Company name</option><option value="created">Recently added</option><option value="industry">Industry</option></select></div><div class="col-md-2"><button class="btn btn-quiet w-100">Apply filters</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table table-hover" id="clients-table"><thead><tr><th>Company</th><th>Contact</th><th>Industry</th><th>Account manager</th><th>Status</th><th></th></tr></thead><tbody>@foreach (var client in Model) { <tr><td><a asp-action="Details" asp-route-id="@client.Id">@client.CompanyName</a><div class="record-meta">@client.City, @client.Country</div></td><td>@client.ContactPerson<div class="record-meta">@client.Email</div></td><td>@client.Industry</td><td>@client.AccountManager</td><td><span class="status-chip">@client.Status</span></td><td><a class="btn btn-sm btn-outline-secondary" asp-action="Edit" asp-route-id="@client.Id">Edit</a></td></tr>}</tbody></table></div>@if (!Model.Any()) { <div class="empty-state">No clients match the selected filters.</div> }</section>
@if (ViewBag.TotalPages > 1) { <nav class="mt-3"><ul class="pagination"><li class="page-item @(ViewBag.Page <= 1 ? "disabled" : "")"><a class="page-link" asp-route-page="@(ViewBag.Page - 1)" asp-route-search="@ViewBag.Search">Previous</a></li><li class="page-item disabled"><span class="page-link">Page @ViewBag.Page of @ViewBag.TotalPages</span></li><li class="page-item @(ViewBag.Page >= ViewBag.TotalPages ? "disabled" : "")"><a class="page-link" asp-route-page="@(ViewBag.Page + 1)" asp-route-search="@ViewBag.Search">Next</a></li></ul></nav>}
