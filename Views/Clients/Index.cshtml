@model List<Client>
@{ ViewData["Title"] = "Clients"; }
<div class="page-wrap module-page"><div class="page-heading"><div><span class="eyebrow">Relationships / Accounts</span><h1>Clients</h1><p class="heading-sub">Coordinate stakeholders and keep every engagement connected.</p></div><div class="heading-actions"><button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Add client</button></div></div><div class="panel module-panel"><div class="module-toolbar"><form class="search-form" method="get"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" placeholder="Search companies, contacts or industries..." /><button class="btn btn-ghost">Search</button></form><span class="result-count">@Model.Count client accounts</span></div><div class="client-grid">@foreach(var c in Model){<a class="client-card" asp-action="Details" asp-route-id="@c.Id"><div class="client-card-top"><span class="entity-avatar blue">@c.CompanyName[0]</span><span class="status-pill active">@c.Status</span></div><h3>@c.CompanyName</h3><p>@c.Industry · @c.City, @c.Country</p><div class="client-meta"><span><i class="bi bi-person"></i> @c.ContactPerson</span><span><i class="bi bi-kanban"></i> @c.Projects.Count projects</span></div><div class="client-email">@c.Email</div></a>}</div></div></div>
