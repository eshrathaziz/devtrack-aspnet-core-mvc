@model Client
@{ ViewData["Title"] = "Add client"; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">New client</div><h1>Create a client record.</h1><p>Set the commercial context before work is planned.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to clients</a></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="CompanyName" class="form-label"></label><input asp-for="CompanyName" class="form-control" /><span asp-validation-for="CompanyName" class="text-danger"></span></div><div class="col-md-6"><label asp-for="ContactPerson" class="form-label"></label><input asp-for="ContactPerson" class="form-control" /><span asp-validation-for="ContactPerson" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" /><span asp-validation-for="Email" class="text-danger"></span></div><div class="col-md-6"><label asp-for="Phone" class="form-label"></label><input asp-for="Phone" class="form-control" /></div><div class="col-md-4"><label asp-for="Industry" class="form-label"></label><input asp-for="Industry" class="form-control" /></div><div class="col-md-4"><label asp-for="City" class="form-label"></label><input asp-for="City" class="form-control" /></div><div class="col-md-4"><label asp-for="Country" class="form-label"></label><input asp-for="Country" class="form-control" /></div><div class="col-md-8"><label asp-for="Address" class="form-label"></label><input asp-for="Address" class="form-control" /></div><div class="col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" asp-items="Html.GetEnumSelectList<ClientStatus>()" class="form-select"></select></div><div class="col-md-2"><label asp-for="AccountManager" class="form-label"></label><input asp-for="AccountManager" class="form-control" /></div></div><div class="mt-4"><button class="btn btn-signal">Create client</button></div></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
