@model DeveloperProfile
@{ ViewData["Title"] = "Add developer"; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">Team profile</div><h1>Add capacity to the team.</h1><p>Record the working profile used for task assignment and workload review.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to workload</a></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="DisplayName" class="form-label"></label><input asp-for="DisplayName" class="form-control" /></div><div class="col-md-3"><label asp-for="ExperienceLevel" class="form-label"></label><select asp-for="ExperienceLevel" class="form-select" asp-items="Html.GetEnumSelectList<ExperienceLevel>()"></select></div><div class="col-md-3"><label asp-for="Availability" class="form-label"></label><select asp-for="Availability" class="form-select" asp-items="Html.GetEnumSelectList<AvailabilityStatus>()"></select></div><div class="col-md-9"><label asp-for="Skills" class="form-label"></label><input asp-for="Skills" class="form-control" placeholder="e.g. C#, ASP.NET Core, SQL Server" /></div><div class="col-md-3"><label asp-for="CurrentWorkload" class="form-label"></label><input asp-for="CurrentWorkload" class="form-control" /></div></div><button class="btn btn-signal mt-4">Create profile</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
