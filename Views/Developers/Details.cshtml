@model DeveloperProfile
@{ ViewData["Title"] = Model.DisplayName; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">Developer profile</div><h1>@Model.DisplayName</h1><p>@Model.ExperienceLevel · @Model.Availability</p></div><a class="btn btn-outline-secondary" asp-action="Index">All workload</a></div>
<div class="detail-grid"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Assigned work</div><h2 class="panel-title">Current delivery commitments</h2></div></div><div class="table-responsive"><table class="table"><thead><tr><th>Task</th><th>Project</th><th>Due</th><th>Status</th></tr></thead><tbody>@foreach (var task in Model.AssignedTasks.OrderBy(t => t.DueDate)) { <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id">@task.Title</a></td><td>@task.Project?.Name</td><td>@(task.DueDate?.ToString("dd MMM") ?? "—")</td><td><span class="status-chip">@task.Status</span></td></tr>}</tbody></table></div></section><aside class="d-grid gap-3"><section class="panel p-3"><div class="panel-kicker">Capacity</div><div class="key-value"><small>Current workload</small><strong>@Model.CurrentWorkload%</strong></div><div class="progress"><div class="progress-bar" style="width:@Model.CurrentWorkload%"></div></div><div class="key-value"><small>Skills</small><strong>@Model.Skills</strong></div><div class="key-value"><small>Assigned bugs</small><strong>@Model.AssignedBugs.Count(b => b.Status != BugStatus.Closed)</strong></div></section></aside></div>
