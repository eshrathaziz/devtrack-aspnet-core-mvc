@model List<DeveloperProfile>
@{ ViewData["Title"] = "Team workload"; }
<div class="page-wrap module-page"><div class="page-heading"><div><span class="eyebrow">Delivery / Capacity</span><h1>Team workload</h1><p class="heading-sub">Balance assignments with the skills and availability your roadmap needs.</p></div><div class="heading-actions"><button class="btn btn-ghost"><i class="bi bi-download"></i> Export capacity</button><button class="btn btn-primary"><i class="bi bi-person-plus"></i> Add developer</button></div></div><div class="panel module-panel"><div class="module-toolbar"><span class="eyebrow mb-0">Current capacity</span><span class="result-count">@Model.Count contributors · refreshed just now</span></div><div class="workload-grid">@foreach(var d in Model){<div class="workload-card"><div class="workload-top"><span class="entity-avatar purple">@string.Join("",d.Name.Split(' ').Select(x=>x[0]))</span><span class="availability @d.Availability.ToLowerInvariant().Replace(" ","-")"><i class="bi bi-circle-fill"></i> @d.Availability</span></div><h3>@d.Name</h3><small>@d.ExperienceLevel · @d.Tasks.Count assigned tasks</small><div class="skill-list">@foreach(var skill in d.Skills.Split(", ").Take(3)){<span>@skill</span>}</div><div class="workload-label"><span>Workload</span><strong>@d.CurrentWorkload%</strong></div><div class="progress workload-progress"><div class="progress-bar @(d.CurrentWorkload>75?"overloaded":"")" style="width:@d.CurrentWorkload%"></div></div><div class="workload-footer"><span><i class="bi bi-check2-circle"></i> @d.Tasks.Count(x=>x.Status==DevTrack.Models.TaskStatus.Done) completed</span><a href="#">View tasks <i class="bi bi-arrow-up-right"></i></a></div></div>}</div></div></div>
