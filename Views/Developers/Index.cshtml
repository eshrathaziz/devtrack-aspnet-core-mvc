@model IEnumerable<DeveloperProfile>
@{ ViewData["Title"] = "Workload"; ViewData["Section"] = "Coordination"; }
<div class="page-heading"><div><div class="breadcrumb-text">Team workload</div><h1>Capacity with context.</h1><p>Balance skills, allocation, and delivery ownership across the team.</p></div><a class="btn btn-signal" asp-action="Create">Add developer</a></div>
<section class="panel"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Developer</th><th>Experience</th><th>Skills</th><th>Availability</th><th>Workload</th><th>Active tasks</th></tr></thead><tbody>@foreach (var developer in Model) { <tr><td><a asp-action="Details" asp-route-id="@developer.Id">@developer.DisplayName</a></td><td>@developer.ExperienceLevel</td><td>@developer.Skills</td><td><span class="status-chip">@developer.Availability</span></td><td><div class="d-flex align-items-center gap-2"><div class="progress flex-grow-1"><div class="progress-bar" style="width:@developer.CurrentWorkload%"></div></div><small>@developer.CurrentWorkload%</small></div></td><td>@developer.AssignedTasks.Count(t => t.Status != DevTrack.Models.TaskStatus.Done)</td></tr>}</tbody></table></div></section>
