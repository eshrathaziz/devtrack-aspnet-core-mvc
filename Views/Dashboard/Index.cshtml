@model DashboardViewModel
@using System.Text.Json
@{
    ViewData["Title"] = "Overview";
    var delta = "+12.4%";
}
<div class="page-wrap">
    <div class="page-heading"><div><span class="eyebrow">Monday, October 14, 2024</span><h1>Good morning, Olivia <span class="wave">✦</span></h1><p class="heading-sub">Here’s what’s happening across your delivery workspace today.</p></div><div class="heading-actions"><button class="btn btn-ghost"><i class="bi bi-download"></i> Export report</button><button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#quickAdd"><i class="bi bi-plus-lg"></i> Quick add</button></div></div>
    <div class="metrics-grid">
        <div class="metric-card accent-purple"><div class="metric-top"><span class="metric-label">Active projects</span><span class="metric-icon"><i class="bi bi-kanban-fill"></i></span></div><div class="metric-value">@Model.ActiveProjects</div><div class="metric-foot"><span class="trend up"><i class="bi bi-arrow-up-right"></i> @delta</span><span>vs last month</span></div></div>
        <div class="metric-card accent-blue"><div class="metric-top"><span class="metric-label">Open requirements</span><span class="metric-icon"><i class="bi bi-file-earmark-text-fill"></i></span></div><div class="metric-value">@Model.OpenRequirements</div><div class="metric-foot"><span class="trend up"><i class="bi bi-arrow-up-right"></i> 4.8%</span><span>vs last month</span></div></div>
        <div class="metric-card accent-teal"><div class="metric-top"><span class="metric-label">Tasks in progress</span><span class="metric-icon"><i class="bi bi-check2-square"></i></span></div><div class="metric-value">@Model.TasksInProgress</div><div class="metric-foot"><span class="trend up"><i class="bi bi-arrow-up-right"></i> 8.1%</span><span>vs last month</span></div></div>
        <div class="metric-card accent-amber"><div class="metric-top"><span class="metric-label">Critical bugs</span><span class="metric-icon"><i class="bi bi-bug-fill"></i></span></div><div class="metric-value">@Model.CriticalBugs</div><div class="metric-foot"><span class="trend down"><i class="bi bi-arrow-down-right"></i> 16.7%</span><span>vs last month</span></div></div>
    </div>
    <div class="dashboard-grid main-row">
        <section class="panel projects-panel"><div class="panel-heading"><div><span class="eyebrow">Portfolio</span><h2>Project health</h2></div><a class="link-action" asp-controller="Projects" asp-action="Index">View all <i class="bi bi-arrow-up-right"></i></a></div><div class="project-list">@foreach (var project in Model.ProjectSummaries) {<div class="project-row"><div class="project-symbol @((project.Priority == Priority.Critical) ? "symbol-coral" : "symbol-purple")">@project.Name.Substring(0,1)</div><div class="project-info"><div class="project-name">@project.Name <span class="status-pill @project.Status.ToString().ToLowerInvariant()">@project.Status</span></div><small>@project.Client · @project.Code</small></div><div class="project-manager"><span class="mini-avatar">@string.Join("", project.Manager.Split(' ').Select(x=>x[0]))</span><small>@project.Manager</small></div><div class="project-progress"><div class="progress-label"><span>@project.Progress% complete</span><span>@(100 - project.Progress)%</span></div><div class="progress"><div class="progress-bar" style="width:@project.Progress%"></div></div></div><i class="bi bi-three-dots more-icon"></i></div>}</div></section>
        <section class="panel activity-panel"><div class="panel-heading"><div><span class="eyebrow">Live feed</span><h2>Recent activity</h2></div><button class="icon-button"><i class="bi bi-sliders2"></i></button></div><div class="activity-list">@foreach (var item in Model.RecentActivity) {<div class="activity-item"><div class="activity-icon @item.Action.ToLowerInvariant()"><i class="bi bi-@(item.Action == "Approved" ? "check-lg" : item.Action == "Assigned" ? "person-plus" : item.Action == "Created" ? "plus-lg" : "rocket-takeoff")"></i></div><div><p><strong>@item.UserName</strong> @item.Description</p><small>@item.Timestamp.ToLocalTime().ToString("MMM d · h:mm tt")</small></div></div>}</div><a href="#" class="activity-footer">Open activity log <i class="bi bi-arrow-right"></i></a></section>
    </div>
    <div class="dashboard-grid analytics-row">
        <section class="panel chart-panel"><div class="panel-heading"><div><span class="eyebrow">Delivery flow</span><h2>Work distribution</h2></div><select class="form-select compact-select"><option>All projects</option><option>CareConnect Portal</option><option>Route Optimizer</option></select></div><div class="chart-wrap"><canvas id="workChart"></canvas></div></section>
        <section class="panel sprint-panel"><div class="panel-heading"><div><span class="eyebrow">Cadence</span><h2>Sprint progress</h2></div><a class="link-action" href="#">Manage <i class="bi bi-arrow-up-right"></i></a></div>@foreach (var sprint in Model.SprintSummaries) {<div class="sprint-item"><div class="sprint-head"><div><strong>@sprint.Name</strong><small>@sprint.Completed of @sprint.Total tasks · @sprint.Points pts</small></div><span class="sprint-percent">@sprint.Progress%</span></div><div class="progress progress-thin"><div class="progress-bar" style="width:@sprint.Progress%"></div></div><div class="sprint-foot"><span><i class="bi bi-calendar3"></i> @sprint.DaysRemaining days left</span><span class="sprint-status">@(sprint.Progress > 50 ? "On track" : "Needs attention")</span></div></div>}</section>
    </div>
    <div class="dashboard-grid bottom-row"><section class="panel tasks-panel"><div class="panel-heading"><div><span class="eyebrow">Execution</span><h2>Recent tasks</h2></div><a class="link-action" asp-controller="Tasks" asp-action="Index">View board <i class="bi bi-arrow-up-right"></i></a></div><div class="table-responsive"><table class="table align-middle task-table"><thead><tr><th>Task</th><th>Project</th><th>Assignee</th><th>Status</th><th>Due</th></tr></thead><tbody>@foreach (var task in Model.RecentTasks) {<tr><td><span class="task-code">@task.TaskCode</span><strong>@task.Title</strong></td><td><span class="project-badge">@task.Project?.Name</span></td><td><span class="mini-avatar teal">@(task.Developer?.Name is null ? "--" : string.Join("", task.Developer.Name.Split(' ').Select(x=>x[0])))</span> @(task.Developer?.Name ?? "Unassigned")</td><td><span class="status-pill task-@task.Status.ToString().ToLowerInvariant()">@task.Status</span></td><td>@task.DueDate.ToString("MMM d")</td></tr>}</tbody></table></div></section><section class="panel bugs-panel"><div class="panel-heading"><div><span class="eyebrow">Quality</span><h2>Needs attention</h2></div><span class="open-count">@Model.OpenBugs open</span></div>@foreach (var bug in Model.PriorityBugs) {<div class="bug-row"><span class="severity-dot severity-@bug.Severity.ToString().ToLowerInvariant()"></span><div><strong>@bug.BugCode · @bug.Title</strong><small>@bug.Project?.Name · @bug.Status</small></div><span class="severity-label">@bug.Severity</span></div>}</section></div>
</div>
<div class="modal fade" id="quickAdd" tabindex="-1"><div class="modal-dialog modal-dialog-centered"><div class="modal-content quick-modal"><div class="modal-header"><div><span class="eyebrow">Create work</span><h3>Quick add</h3></div><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body quick-actions"><a asp-controller="Projects" asp-action="Index" class="quick-action"><span class="quick-action-icon purple"><i class="bi bi-kanban-fill"></i></span><span><strong>New project</strong><small>Set up a client engagement</small></span><i class="bi bi-arrow-up-right"></i></a><a asp-controller="Requirements" asp-action="Index" class="quick-action"><span class="quick-action-icon blue"><i class="bi bi-file-earmark-plus-fill"></i></span><span><strong>New requirement</strong><small>Capture a client need</small></span><i class="bi bi-arrow-up-right"></i></a><a asp-controller="Tasks" asp-action="Index" class="quick-action"><span class="quick-action-icon teal"><i class="bi bi-check2-square"></i></span><span><strong>New task</strong><small>Move work into delivery</small></span><i class="bi bi-arrow-up-right"></i></a><a asp-controller="Bugs" asp-action="Index" class="quick-action"><span class="quick-action-icon coral"><i class="bi bi-bug-fill"></i></span><span><strong>Report a bug</strong><small>Keep quality visible</small></span><i class="bi bi-arrow-up-right"></i></a></div></div></div></div>
@section Scripts {<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.4/dist/chart.umd.min.js"></script><script>const taskData = @Html.Raw(JsonSerializer.Serialize(Model.TaskStatusData)); const bugData = @Html.Raw(JsonSerializer.Serialize(Model.BugSeverityData)); new Chart(document.getElementById('workChart'), { type:'bar', data:{ labels:Object.keys(taskData), datasets:[{ label:'Tasks', data:Object.values(taskData), backgroundColor:['#d9d4ff','#b4a9ff','#7f73e6','#47c3b6','#f7b955','#f27965','#a9b1c3'], borderRadius:8, borderSkipped:false, barThickness:18 }] }, options:{ responsive:true, maintainAspectRatio:false, plugins:{legend:{display:false}}, scales:{x:{grid:{display:false}, ticks:{color:'#8992a6',font:{family:'DM Sans',size:11}}},y:{beginAtZero:true,grid:{color:'#edf0f5'},ticks:{color:'#8992a6',stepSize:1}}} } });</script>}
