@model Bug
@{ ViewData["Title"] = Model.Title; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Defect record</div><h1>@Model.Title</h1><p>@Model.Project?.Name · Reported by @Model.Reporter</p></div><a class="btn btn-outline-secondary" asp-action="Index">All bugs</a></div>
<section class="detail-hero"><div class="detail-meta">@Model.Severity severity · @Model.Priority priority · @Model.Status</div><h1>@Model.Title</h1><p>@Model.Description</p></section>
<div class="detail-grid"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Defect discussion</div><h2 class="panel-title">Resolution notes</h2></div></div><div class="list-stack" id="bug-comments">@foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAtUtc)) { <div class="list-row"><span class="list-marker berry"></span><div><span class="list-title">@comment.AuthorName</span><span class="list-desc">@comment.Comment</span></div><span class="activity-time">@comment.CreatedAtUtc.ToString("dd MMM HH:mm")</span></div>}</div><form class="comment-form p-3 border-top" asp-controller="Comments" asp-action="Add" data-comment-target="#bug-comments"><input type="hidden" name="BugId" value="@Model.Id" />@Html.AntiForgeryToken()<textarea class="form-control mb-2" name="Comment" rows="3" placeholder="Add investigation or verification notes" required></textarea><div class="comment-error text-danger small mb-2"></div><button class="btn btn-signal">Add note</button></form></section><aside class="panel p-3"><div class="panel-kicker">Resolution context</div><div class="key-value"><small>Related task</small><strong>@Model.TaskItem?.Title</strong></div><div class="key-value"><small>Assigned developer</small><strong>@(Model.AssignedDeveloper?.DisplayName ?? "Unassigned")</strong></div><div class="key-value"><small>Resolved date</small><strong>@(Model.ResolvedAtUtc?.ToString("dd MMM yyyy") ?? "Open")</strong></div><div class="key-value"><small>Release</small><strong>@Model.Release?.Version</strong></div><hr /><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label">Move defect to</label><select class="form-select mb-2" name="status" asp-items="Html.GetEnumSelectList<BugStatus>()"></select><button class="btn btn-signal w-100">Update status</button></form></aside></div>

