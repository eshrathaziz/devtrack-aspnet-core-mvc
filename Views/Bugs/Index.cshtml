@model IEnumerable<Bug>
@{ ViewData["Title"] = "Bugs"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Quality queue</div><h1>Defects need clear ownership.</h1><p>Track severity, investigation, testing, and release readiness.</p></div>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager") || User.IsInRole("Tester")) { <a class="btn btn-signal" asp-action="Create">Report bug</a> }</div>
<form class="filter-bar row g-2" method="get"><div class="col-md-4"><select class="form-select" name="projectId" asp-items="ViewBag.Projects"><option value="">All projects</option></select></div><div class="col-md-3"><select class="form-select" name="status" asp-items="Html.GetEnumSelectList<BugStatus>()"><option value="">All statuses</option></select></div><div class="col-md-3"><select class="form-select" name="severity" asp-items="Html.GetEnumSelectList<BugSeverity>()"><option value="">All severities</option></select></div><div class="col-md-2"><button class="btn btn-quiet w-100">Filter</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Defect</th><th>Project</th><th>Severity</th><th>Owner</th><th>Status</th><th>Reported</th></tr></thead><tbody>@foreach (var bug in Model) { <tr><td><a asp-action="Details" asp-route-id="@bug.Id">@bug.Title</a><div class="record-meta">@bug.Reporter</div></td><td>@bug.Project?.Name</td><td><span class="priority-chip @(bug.Severity == BugSeverity.Critical ? "critical" : "")">@bug.Severity</span></td><td>@(bug.AssignedDeveloper?.DisplayName ?? "Unassigned")</td><td><span class="status-chip @(bug.Status == BugStatus.Reopened ? "blocked" : "")">@bug.Status</span></td><td>@bug.CreatedAtUtc.ToString("dd MMM")</td></tr>}</tbody></table></div></section>
