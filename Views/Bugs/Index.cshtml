@model List<Bug>
@{ ViewData["Title"] = "Bug tracker"; }
<div class="page-wrap module-page"><div class="page-heading"><div><span class="eyebrow">Quality / Triage</span><h1>Bug tracker</h1><p class="heading-sub">Protect the release by keeping defects visible, owned, and moving.</p></div><div class="heading-actions"><button class="btn btn-ghost"><i class="bi bi-bar-chart"></i> Quality report</button><button class="btn btn-primary"><i class="bi bi-plus-lg"></i> Report bug</button></div></div><div class="metrics-grid bug-metrics"><div class="metric-card accent-coral"><div class="metric-top"><span class="metric-label">Open bugs</span><span class="metric-icon"><i class="bi bi-bug-fill"></i></span></div><div class="metric-value">@Model.Count(x=>x.Status != BugStatus.Closed)</div><div class="metric-foot"><span>Across all projects</span></div></div><div class="metric-card accent-amber"><div class="metric-top"><span class="metric-label">Critical</span><span class="metric-icon"><i class="bi bi-exclamation-triangle-fill"></i></span></div><div class="metric-value">@Model.Count(x=>x.Severity == BugSeverity.Critical)</div><div class="metric-foot"><span class="trend down">Needs triage</span></div></div><div class="metric-card accent-blue"><div class="metric-top"><span class="metric-label">In testing</span><span class="metric-icon"><i class="bi bi-shield-check"></i></span></div><div class="metric-value">@Model.Count(x=>x.Status == BugStatus.Testing)</div><div class="metric-foot"><span>Ready for verification</span></div></div><div class="metric-card accent-teal"><div class="metric-top"><span class="metric-label">Resolved this cycle</span><span class="metric-icon"><i class="bi bi-check-circle-fill"></i></span></div><div class="metric-value">@Model.Count(x=>x.Status == BugStatus.Closed)</div><div class="metric-foot"><span class="trend up">On track</span></div></div></div><div class="panel module-panel"><div class="module-toolbar"><form class="search-form" method="get"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" placeholder="Search bugs, projects or codes..." /><button class="btn btn-ghost">Search</button></form><select class="filter-select" onchange="location.href='?status='+this.value"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<BugStatus>()){<option value="@status">@status</option>}</select><span class="result-count">@Model.Count issues</span></div><div class="table-responsive"><table class="table align-middle module-table"><thead><tr><th>Issue</th><th>Project</th><th>Severity</th><th>Assignee</th><th>Status</th><th>Reported</th><th>Update</th></tr></thead><tbody>@foreach(var b in Model){<tr><td><span class="task-code">@b.BugCode</span><strong class="table-title">@b.Title</strong><small class="table-muted">@b.Description</small></td><td>@b.Project?.Name</td><td><span class="severity-label severity-text-@b.Severity.ToString().ToLowerInvariant()"><i class="bi bi-circle-fill"></i> @b.Severity</span></td><td><span class="assignee"><span class="mini-avatar">@(b.Developer?.Name is null ? "--" : string.Join("",b.Developer.Name.Split(' ').Select(x=>x[0])))</span>@(b.Developer?.Name ?? "Unassigned")</span></td><td><span class="status-pill @b.Status.ToString().ToLowerInvariant()">@b.Status</span></td><td>@b.CreatedAt.ToString("MMM d")</td><td><form asp-action="UpdateStatus" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@b.Id" /><select name="status" class="status-select" onchange="this.form.submit()"><option value="@b.Status">Update</option>@foreach(var next in Enum.GetValues<BugStatus>().Where(x=>x!=b.Status)){<option value="@next">@next</option>}</select></form></td></tr>}</tbody></table></div></div></div>
