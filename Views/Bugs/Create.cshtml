@model Bug
@{ ViewData["Title"] = "Report bug"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">New defect</div><h1>Report a defect with evidence.</h1><p>Connect it to delivery work so fixes can be verified and released.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to bugs</a></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div><div class="col-md-4"><label asp-for="ProjectId" class="form-label"></label><select asp-for="ProjectId" class="form-select" asp-items="ViewBag.Projects"><option value="">Select project</option></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="5" placeholder="Steps, evidence, expected result, and actual result."></textarea></div><div class="col-md-3"><label asp-for="TaskItemId" class="form-label"></label><select asp-for="TaskItemId" class="form-select" asp-items="ViewBag.Tasks"><option value="">No linked task</option></select></div><div class="col-md-3"><label asp-for="AssignedDeveloperId" class="form-label"></label><select asp-for="AssignedDeveloperId" class="form-select" asp-items="ViewBag.Developers"><option value="">Unassigned</option></select></div><div class="col-md-2"><label asp-for="Severity" class="form-label"></label><select asp-for="Severity" class="form-select" asp-items="Html.GetEnumSelectList<BugSeverity>()"></select></div><div class="col-md-2"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div><div class="col-md-2"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<BugStatus>()"></select></div></div><button class="btn btn-signal mt-4">Record bug</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
