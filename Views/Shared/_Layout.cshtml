@using DevTrack.Data
@inject ApplicationDbContext Db
@{
    var notifications = Db.Notifications.OrderByDescending(x => x.CreatedAt).Take(3).ToList();
    var current = ViewContext.RouteData.Values["controller"]?.ToString() ?? "Dashboard";
    var unread = Db.Notifications.Count(x => !x.IsRead);
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] · DevTrack</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
<div class="app-shell">
    <aside class="sidebar">
        <div class="brand"><span class="brand-mark"><i class="bi bi-command"></i></span><span>devtrack<span class="brand-dot">.</span></span></div>
        <div class="workspace-switcher"><span class="workspace-icon">N</span><span><small>Workspace</small><strong>Northstar Digital</strong></span><i class="bi bi-chevron-expand ms-auto"></i></div>
        <nav class="nav-section">
            <p class="nav-label">Workspace</p>
            <a class="nav-link @(current == "Dashboard" ? "active" : "")" asp-controller="Dashboard" asp-action="Index"><i class="bi bi-grid-1x2-fill"></i><span>Overview</span></a>
            <a class="nav-link @(current == "Projects" ? "active" : "")" asp-controller="Projects" asp-action="Index"><i class="bi bi-kanban-fill"></i><span>Projects</span><em>6</em></a>
            <a class="nav-link @(current == "Requirements" ? "active" : "")" asp-controller="Requirements" asp-action="Index"><i class="bi bi-file-earmark-text-fill"></i><span>Requirements</span><em class="alert-count">12</em></a>
            <a class="nav-link @(current == "Tasks" ? "active" : "")" asp-controller="Tasks" asp-action="Index"><i class="bi bi-check2-square"></i><span>My tasks</span><em>18</em></a>
            <a class="nav-link @(current == "Bugs" ? "active" : "")" asp-controller="Bugs" asp-action="Index"><i class="bi bi-bug-fill"></i><span>Bug tracker</span><em class="alert-count">4</em></a>
        </nav>
        <nav class="nav-section mt-4">
            <p class="nav-label">Delivery</p>
            <a class="nav-link @(current == "Developers" ? "active" : "")" asp-controller="Developers" asp-action="Index"><i class="bi bi-people-fill"></i><span>Team workload</span></a>
            <a class="nav-link @(current == "Releases" ? "active" : "")" asp-controller="Releases" asp-action="Index"><i class="bi bi-rocket-takeoff-fill"></i><span>Releases</span></a>
            <a class="nav-link" href="#"><i class="bi bi-bar-chart-fill"></i><span>Reports</span></a>
            <a class="nav-link @(current == "Clients" ? "active" : "")" asp-controller="Clients" asp-action="Index"><i class="bi bi-building-fill"></i><span>Clients</span></a>
        </nav>
        <div class="sidebar-bottom">
            <a class="nav-link" href="#"><i class="bi bi-question-circle-fill"></i><span>Help center</span></a>
            <a class="nav-link" href="#"><i class="bi bi-gear-fill"></i><span>Settings</span></a>
            <div class="user-chip"><div class="avatar avatar-purple">OM</div><span><strong>Olivia Morgan</strong><small>Project Manager</small></span><i class="bi bi-three-dots ms-auto"></i></div>
        </div>
    </aside>
    <main class="main-content">
        <header class="topbar"><button class="mobile-toggle" type="button"><i class="bi bi-list"></i></button><div class="crumb"><span>Northstar Digital</span><i class="bi bi-chevron-right"></i><strong>@(current == "Dashboard" ? "Overview" : current)</strong></div><div class="top-actions"><div class="global-search"><i class="bi bi-search"></i><input id="globalSearch" placeholder="Search anything..." /><kbd>⌘ K</kbd></div><button class="icon-button notification-button" type="button" data-bs-toggle="offcanvas" data-bs-target="#notificationPanel"><i class="bi bi-bell"></i><span class="notification-dot">@unread</span></button><div class="avatar avatar-purple">OM</div></div></header>
        @if (TempData["Error"] is string error) { <div class="alert alert-danger mx-4 mt-3 mb-0">@error</div> }
        @RenderBody()
    </main>
</div>
<div class="offcanvas offcanvas-end" tabindex="-1" id="notificationPanel"><div class="offcanvas-header"><div><span class="eyebrow">Inbox</span><h5 class="offcanvas-title">Notifications</h5></div><button type="button" class="btn-close" data-bs-dismiss="offcanvas"></button></div><div class="offcanvas-body">@foreach (var note in notifications) { <div class="notification-item"><span class="note-icon"><i class="bi bi-lightning-charge-fill"></i></span><div><strong>@note.Title</strong><p>@note.Message</p><small>@note.CreatedAt.ToLocalTime().ToString("MMM d · h:mm tt")</small></div></div> }</div></div>
<script src="https://cdn.jsdelivr.net/npm/jquery@3.7.1/dist/jquery.min.js"></script><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)
</body></html>
