@model TaskItem
@{ ViewData["Title"] = Model.Title; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Task record</div><h1>@Model.Title</h1><p>@Model.Project?.Name · @Model.Sprint?.Name</p></div><a class="btn btn-outline-secondary" asp-action="Index">All tasks</a></div>
<section class="detail-hero"><div class="detail-meta">@Model.Priority priority · @Model.Status · Due @(Model.DueDate?.ToString("dd MMM yyyy") ?? "not set")</div><h1>@Model.Title</h1><p>@Model.Description</p></section>
<div class="detail-grid"><div class="d-grid gap-3"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Technical notes</div><h2 class="panel-title">Collaboration record</h2></div></div><div class="list-stack" id="task-comments">@foreach (var comment in Model.Comments.OrderByDescending(c => c.CreatedAtUtc)) { <div class="list-row"><span class="list-marker berry"></span><div><span class="list-title">@comment.AuthorName</span><span class="list-desc">@comment.Comment</span></div><span class="activity-time">@comment.CreatedAtUtc.ToString("dd MMM HH:mm")</span></div>}</div><form class="comment-form p-3 border-top" asp-controller="Comments" asp-action="Add" data-comment-target="#task-comments"><input type="hidden" name="TaskItemId" value="@Model.Id" />@Html.AntiForgeryToken()<textarea class="form-control mb-2" name="Comment" rows="3" placeholder="Add a technical note or decision" required></textarea><div class="comment-error text-danger small mb-2"></div><button class="btn btn-signal">Add note</button></form></section></div><aside class="panel p-3"><div class="panel-kicker">Delivery context</div><div class="key-value"><small>Owner</small><strong>@(Model.Developer?.DisplayName ?? "Unassigned")</strong></div><div class="key-value"><small>Requirement</small><strong>@Model.Requirement?.Title</strong></div><div class="key-value"><small>Effort</small><strong>@Model.StoryPoints points · @Model.EstimatedHours h</strong></div><div class="key-value"><small>Actual hours</small><strong>@Model.ActualHours h</strong></div><hr /><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label">Move task to</label><select class="form-select mb-2" name="status" asp-items="Html.GetEnumSelectList<DevTrack.Models.TaskStatus>()"></select><button class="btn btn-signal w-100">Update status</button></form>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <form class="mt-3" asp-action="Assign" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label">Assignment</label><select class="form-select mb-2" name="developerProfileId" asp-items="ViewBag.Developers"><option value="">Unassigned</option></select><button class="btn btn-quiet w-100">Update assignment</button></form> }</aside></div>
