@model List<TaskItem>
@{ ViewData["Title"] = "My tasks"; }
<div class="page-wrap module-page"><div class="page-heading"><div><span class="eyebrow">Workspace / Execution</span><h1>My tasks</h1><p class="heading-sub">Keep delivery moving with clear ownership and next actions.</p></div><div class="heading-actions"><button class="btn btn-ghost"><i class="bi bi-layout-three-columns"></i> Board view</button><button class="btn btn-primary"><i class="bi bi-plus-lg"></i> New task</button></div></div><div class="panel module-panel"><div class="module-toolbar"><form class="search-form" method="get"><i class="bi bi-search"></i><input name="search" value="@ViewBag.Search" placeholder="Search tasks or codes..." /><button class="btn btn-ghost">Search</button></form><select class="filter-select" onchange="location.href='?status='+this.value"><option value="">All statuses</option>@foreach(var status in Enum.GetValues<DevTrack.Models.TaskStatus>()){<option value="@status">@status</option>}</select><span class="result-count">@Model.Count tasks</span></div><div class="table-responsive"><table class="table align-middle module-table"><thead><tr><th>Task</th><th>Project / sprint</th><th>Assignee</th><th>Priority</th><th>Status</th><th>Due</th><th>Action</th></tr></thead><tbody>@foreach(var t in Model){<tr><td><span class="task-code">@t.TaskCode</span><strong class="table-title">@t.Title</strong><small class="table-muted">@t.StoryPoints points · @t.EstimatedHours h estimated</small></td><td><strong class="table-title">@t.Project?.Name</strong><small class="table-muted">@t.Sprint?.Name</small></td><td><span class="assignee"><span class="mini-avatar teal">@(t.Developer?.Name is null ? "--" : string.Join("",t.Developer.Name.Split(' ').Select(x=>x[0])))</span>@(t.Developer?.Name ?? "Unassigned")</span></td><td><span class="priority-text priority-@t.Priority.ToString().ToLowerInvariant()"><i class="bi bi-flag-fill"></i> @t.Priority</span></td><td><span class="status-pill task-@t.Status.ToString().ToLowerInvariant()">@t.Status</span></td><td><span class="date-range">@t.DueDate.ToString("MMM d, yyyy")</span></td><td><form asp-action="UpdateStatus" method="post" class="d-flex gap-1">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@t.Id" /><select name="status" class="status-select"><option value="@t.Status">@t.Status</option>@foreach(var next in Enum.GetValues<DevTrack.Models.TaskStatus>().Where(x=>x!=t.Status)){<option value="@next">Move to @next</option>}</select><button class="icon-button submit-icon" title="Update status"><i class="bi bi-arrow-right-circle"></i></button></form></td></tr>}</tbody></table></div></div></div>
