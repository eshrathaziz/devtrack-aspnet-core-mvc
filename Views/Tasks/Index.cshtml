@model IEnumerable<TaskItem>
@{ ViewData["Title"] = "Tasks"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Delivery queue</div><h1>Tasks with a next move.</h1><p>Prioritise work, assign responsibility, and maintain flow.</p></div>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <a class="btn btn-signal" asp-action="Create">Create task</a> }</div>
<form class="filter-bar row g-2" method="get"><div class="col-md-3"><input class="form-control" name="search" placeholder="Search tasks" /></div><div class="col-md-2"><select class="form-select" name="projectId" asp-items="ViewBag.Projects"><option value="">All projects</option></select></div><div class="col-md-2"><select class="form-select" name="developerId" asp-items="ViewBag.Developers"><option value="">All owners</option></select></div><div class="col-md-2"><select class="form-select" name="status" asp-items="Html.GetEnumSelectList<DevTrack.Models.TaskStatus>()"><option value="">All statuses</option></select></div><div class="col-md-2"><select class="form-select" name="priority" asp-items="Html.GetEnumSelectList<Priority>()"><option value="">All priorities</option></select></div><div class="col-md-1"><button class="btn btn-quiet w-100">Go</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Task</th><th>Project / sprint</th><th>Owner</th><th>Priority</th><th>Status</th><th>Due</th></tr></thead><tbody>@foreach (var task in Model) { <tr><td><a asp-action="Details" asp-route-id="@task.Id">@task.Title</a><div class="record-meta">@task.StoryPoints points · @task.EstimatedHours hours estimated</div></td><td>@task.Project?.Name<div class="record-meta">@task.Sprint?.Name</div></td><td>@(task.Developer?.DisplayName ?? "Unassigned")</td><td><span class="priority-chip @(task.Priority == Priority.Critical ? "critical" : "")">@task.Priority</span></td><td><span class="status-chip @(task.Status == DevTrack.Models.TaskStatus.Blocked ? "blocked" : "")">@task.Status</span></td><td>@(task.DueDate?.ToString("dd MMM") ?? "—")</td></tr>}</tbody></table></div></section>
