@model TaskItem
@{ ViewData["Title"] = "Create task"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">New task</div><h1>Make work executable.</h1><p>Connect each task to a project, sprint, requirement, and accountable owner.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to tasks</a></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-8"><label asp-for="Title" class="form-label"></label><input asp-for="Title" class="form-control" /></div><div class="col-md-4"><label asp-for="ProjectId" class="form-label"></label><select asp-for="ProjectId" class="form-select" asp-items="ViewBag.Projects"><option value="">Select project</option></select></div><div class="col-12"><label asp-for="Description" class="form-label"></label><textarea asp-for="Description" class="form-control" rows="4"></textarea></div><div class="col-md-4"><label asp-for="SprintId" class="form-label"></label><select asp-for="SprintId" class="form-select" asp-items="ViewBag.Sprints"><option value="">Unscheduled</option></select></div><div class="col-md-4"><label asp-for="RequirementId" class="form-label"></label><select asp-for="RequirementId" class="form-select" asp-items="ViewBag.Requirements"><option value="">No direct requirement</option></select></div><div class="col-md-4"><label asp-for="DeveloperProfileId" class="form-label"></label><select asp-for="DeveloperProfileId" class="form-select" asp-items="ViewBag.Developers"><option value="">Unassigned</option></select></div><div class="col-md-3"><label asp-for="Priority" class="form-label"></label><select asp-for="Priority" class="form-select" asp-items="Html.GetEnumSelectList<Priority>()"></select></div><div class="col-md-3"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<DevTrack.Models.TaskStatus>()"></select></div><div class="col-md-2"><label asp-for="StoryPoints" class="form-label"></label><input asp-for="StoryPoints" class="form-control" /></div><div class="col-md-2"><label asp-for="EstimatedHours" class="form-label"></label><input asp-for="EstimatedHours" class="form-control" /></div><div class="col-md-2"><label asp-for="DueDate" class="form-label"></label><input asp-for="DueDate" class="form-control" /></div></div><button class="btn btn-signal mt-4">Create task</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
