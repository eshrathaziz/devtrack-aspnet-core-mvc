@model IEnumerable<Sprint>
@{ ViewData["Title"] = "Sprints"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">Delivery cadence</div><h1>Sprint planning.</h1><p>Make the committed work, progress, and remaining scope visible.</p></div>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <a class="btn btn-signal" asp-action="Create">Create sprint</a> }</div>
<form class="filter-bar row g-2" method="get"><div class="col-md-5"><select class="form-select" name="projectId" asp-items="ViewBag.Projects"><option value="">All projects</option></select></div><div class="col-md-5"><select class="form-select" name="status" asp-items="Html.GetEnumSelectList<SprintStatus>()"><option value="">All statuses</option></select></div><div class="col-md-2"><button class="btn btn-quiet w-100">Filter</button></div></form>
<section class="panel"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>Sprint</th><th>Project</th><th>Window</th><th>Goal</th><th>Tasks</th><th>Status</th></tr></thead><tbody>@foreach (var sprint in Model) { var completed = sprint.Tasks.Count(t => t.Status == DevTrack.Models.TaskStatus.Done); <tr><td><a asp-action="Details" asp-route-id="@sprint.Id">@sprint.Name</a></td><td>@sprint.Project?.Name</td><td>@sprint.StartDate.ToString("dd MMM") – @sprint.EndDate.ToString("dd MMM")</td><td>@sprint.Goal</td><td>@completed / @sprint.Tasks.Count done</td><td><span class="status-chip">@sprint.Status</span></td></tr>}</tbody></table></div></section>
