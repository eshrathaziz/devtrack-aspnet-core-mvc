@model Sprint
@{ ViewData["Title"] = Model.Name; ViewData["Section"] = "Workspace"; var completed = Model.Tasks.Count(t => t.Status == DevTrack.Models.TaskStatus.Done); var points = Model.Tasks.Sum(t => t.StoryPoints); }
<div class="page-heading"><div><div class="breadcrumb-text">Sprint plan</div><h1>@Model.Name</h1><p>@Model.Project?.Name · @Model.StartDate.ToString("dd MMM") – @Model.EndDate.ToString("dd MMM yyyy")</p></div><a class="btn btn-outline-secondary" asp-action="Index">All sprints</a></div>
<section class="detail-hero"><div class="detail-meta">@Model.Status · @Model.Tasks.Count tasks · @points story points</div><h1>@Model.Name</h1><p>@Model.Goal</p></section>
<div class="detail-grid"><section class="panel"><div class="panel-head"><div><div class="panel-kicker">Sprint backlog</div><h2 class="panel-title">Committed tasks</h2></div><a class="btn btn-sm btn-quiet" asp-controller="Tasks" asp-action="Create">Create task</a></div><div class="table-responsive"><table class="table"><thead><tr><th>Task</th><th>Owner</th><th>Points</th><th>Status</th></tr></thead><tbody>@foreach (var task in Model.Tasks.OrderBy(t => t.Status)) { <tr><td><a asp-controller="Tasks" asp-action="Details" asp-route-id="@task.Id">@task.Title</a></td><td>@task.Developer?.DisplayName</td><td>@task.StoryPoints</td><td><span class="status-chip">@task.Status</span></td></tr>}</tbody></table></div></section><aside class="panel p-3"><div class="panel-kicker">Sprint health</div><div class="key-value"><small>Completion</small><strong>@completed / @Model.Tasks.Count tasks</strong></div><div class="key-value"><small>Story points</small><strong>@points</strong></div>@if (User.IsInRole("Administrator") || User.IsInRole("Project Manager")) { <hr /><form asp-action="UpdateStatus" method="post"><input type="hidden" name="id" value="@Model.Id" /><label class="form-label">Update sprint status</label><select class="form-select mb-2" name="status" asp-items="Html.GetEnumSelectList<SprintStatus>()"></select><button class="btn btn-signal w-100">Save status</button></form> }</aside></div>
