@model Sprint
@{ ViewData["Title"] = "Create sprint"; ViewData["Section"] = "Workspace"; }
<div class="page-heading"><div><div class="breadcrumb-text">New sprint</div><h1>Set the sprint commitment.</h1><p>Define the delivery goal and the timebox that makes it actionable.</p></div><a class="btn btn-outline-secondary" asp-action="Index">Back to sprints</a></div>
<form method="post" class="form-card"><div asp-validation-summary="ModelOnly" class="text-danger"></div><div class="row g-3"><div class="col-md-6"><label asp-for="ProjectId" class="form-label"></label><select asp-for="ProjectId" class="form-select" asp-items="ViewBag.Projects"><option value="">Select project</option></select></div><div class="col-md-6"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /></div><div class="col-12"><label asp-for="Goal" class="form-label"></label><textarea asp-for="Goal" class="form-control" rows="3"></textarea></div><div class="col-md-4"><label asp-for="StartDate" class="form-label"></label><input asp-for="StartDate" class="form-control" /></div><div class="col-md-4"><label asp-for="EndDate" class="form-label"></label><input asp-for="EndDate" class="form-control" /></div><div class="col-md-4"><label asp-for="Status" class="form-label"></label><select asp-for="Status" class="form-select" asp-items="Html.GetEnumSelectList<SprintStatus>()"></select></div></div><button class="btn btn-signal mt-4">Create sprint</button></form>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
